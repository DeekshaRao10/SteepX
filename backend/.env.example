# Optional backend-only overrides. Copy to backend/.env only if it does not exist.
# Precedence: process environment > backend/.env > project .env > defaults.
# The existing project .env already supplies DATABASE_URL; leave this commented
# unless you deliberately need a separate backend value. Match Docker credentials.
# DATABASE_URL=postgresql+psycopg://<DB_USER>:<URL_ENCODED_DB_PASSWORD>@127.0.0.1:5433/<DB_NAME>

# Use a JSON array of exact origins, without paths or trailing slashes.
CORS_ORIGINS=["http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=true
LOG_LEVEL=INFO

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_CONNECT_TIMEOUT_SECONDS=5

# Phase 1 does not consume JWT settings or implement authentication.
# Do not add real credentials to this example file.
